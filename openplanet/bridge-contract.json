{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChaosFX Reward Event",
  "type": "object",
  "required": ["rewardKey"],
  "properties": {
    "rewardKey": {
      "type": "string",
      "enum": ["pink_mode", "kaleidoscope", "mirrored_screen"]
    },
    "durationMs": {
      "type": "integer",
      "minimum": 1000,
      "default": 15000
    },
    "source": {
      "type": "string",
      "default": "twitch"
    }
  },
  "additionalProperties": false
}
