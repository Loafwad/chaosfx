# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ── Required ──────────────────────────────────────────────────────────────────

# Your Twitch app Client ID (dev.twitch.tv → Your Console)
TWITCH_CLIENT_ID=

# User access token with scope: channel:read:redemptions
# Generate at: https://twitchtokengenerator.com
TWITCH_ACCESS_TOKEN=

# Your numeric broadcaster user ID
# Look up at: https://www.streamweasels.com/tools/convert-twitch-username-to-user-id/
TWITCH_BROADCASTER_ID=

# ── Optional ──────────────────────────────────────────────────────────────────

# How long each effect lasts in milliseconds (default: 15000)
# REWARD_DURATION_MS=15000

# Bridge URL — only change if you moved the bridge off localhost
# CHAOSFX_BRIDGE_URL=http://127.0.0.1:18244

# Exact Twitch reward titles — edit if your reward names differ from the defaults
# REWARD_TITLE_PINK_MODE=Pink Mode
# REWARD_TITLE_KALEIDOSCOPE=Kaleidoscope
# REWARD_TITLE_MIRRORED_SCREEN=Mirrored Screen
# REWARD_TITLE_FLIPPED_SCREEN=Flipped Screen
